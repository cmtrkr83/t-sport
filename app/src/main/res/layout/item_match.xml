<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/focus_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/match_row_min_height"
    android:orientation="horizontal"
    android:padding="@dimen/match_row_padding">

    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/body_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textColor="@color/accent"
            android:textSize="@dimen/secondary_text_size"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/homeBadge"
                android:layout_width="@dimen/badge_size"
                android:layout_height="@dimen/badge_size"
                android:background="@drawable/bg_monogram"
                android:focusable="false"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/accent"
                android:textSize="@dimen/secondary_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_text_size"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/awayBadge"
                android:layout_width="@dimen/badge_size"
                android:layout_height="@dimen/badge_size"
                android:background="@drawable/bg_monogram"
                android:focusable="false"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/accent"
                android:textSize="@dimen/secondary_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textAway"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_text_size"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textVenue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="@dimen/secondary_text_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textRound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="@dimen/secondary_text_size"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
